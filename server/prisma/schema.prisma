generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TeamRole {
  VIEWER
  MEMBER
  LEAD
  ADMIN
}

enum WorkType {
  INCIDENT
  CUSTOMER_ISSUE
  PAYMENT
  COMPLIANCE
  TASK
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkStatus {
  OPEN
  IN_PROGRESS
  AWAITING_APPROVAL
  RESOLVED
  CLOSED
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  memberships  Membership[]
  createdItems WorkItem[]   @relation("CreatedItems")
  assignedItems WorkItem[]  @relation("AssignedItems")
  events       ActivityEvent[]
  comments     Comment[]
  createdAt    DateTime     @default(now())
}

model Team {
  id          String       @id @default(cuid())
  name        String       @unique
  memberships Membership[]
  items       WorkItem[]
  createdAt   DateTime     @default(now())
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  role      TeamRole @default(MEMBER)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, teamId])
  @@index([teamId, role])
}

model WorkItem {
  id          String       @id @default(cuid())
  title       String
  description String
  type        WorkType     @default(TASK)
  priority    Priority     @default(MEDIUM)
  status      WorkStatus   @default(OPEN)
  teamId      String
  assigneeId  String?
  createdById String
  dueDate     DateTime?
  version     Int          @default(1)
  team        Team         @relation(fields: [teamId], references: [id])
  assignee    User?        @relation("AssignedItems", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("CreatedItems", fields: [createdById], references: [id])
  events      ActivityEvent[]
  comments    Comment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([teamId, status, priority])
  @@index([teamId, assigneeId, status])
  @@index([createdAt, id])
  @@index([dueDate])
}

model ActivityEvent {
  id         String   @id @default(cuid())
  itemId     String
  actorId    String
  action     String
  field      String?
  oldValue   String?
  newValue   String?
  details    String?
  item       WorkItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  actor      User     @relation(fields: [actorId], references: [id])
  createdAt  DateTime @default(now())

  @@index([itemId, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  itemId    String
  authorId  String
  body      String
  item      WorkItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([itemId, createdAt])
}

model IdempotencyRecord {
  id          String   @id @default(cuid())
  key         String   @unique
  userId      String
  response    Json
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model OutboxJob {
  id          String   @id @default(cuid())
  type        String
  payload     Json
  status      String   @default("PENDING")
  attempts    Int      @default(0)
  runAfter    DateTime @default(now())
  processedAt DateTime?
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, runAfter])
}
